PROJECT_NAME=信息集成管理系统
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./app.db

# 认证后端,按顺序尝试
AUTH_BACKENDS=["local","ldap"]

# AD / LDAP 配置(生产必须使用 ldaps://)
LDAP_ENABLED=false
LDAP_SERVER=ldaps://dc.corp.com
LDAP_BIND_DN=CN=svc-iis,OU=Service,DC=corp,DC=com
LDAP_BIND_PASSWORD=change-me
LDAP_BASE_DN=DC=corp,DC=com
LDAP_CONNECT_TIMEOUT=5
LDAP_AUTO_PROVISION=true
# AD 组 DN(或组 CN) -> 本地角色 code
LDAP_GROUP_ROLE_MAP={"CN=IIS-Admins,OU=Groups,DC=corp,DC=com":"admin"}

# ---- OIDC 统一身份认证 ----
OIDC_ENABLED=false
OIDC_ISSUER=https://platform.liangkui.co/platform/idp
OIDC_CLIENT_ID=iis-web
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES=openid profile email groups
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=http://127.0.0.1:5173/oidc-callback
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_ROLE_MAP={"iis-admins":"admin"}
OIDC_VERIFY_SSL=true
OIDC_COOKIE_SECURE=false

# ---- Baserow 数据源 ----
BASEROW_ENABLED=false
BASEROW_URL=http://192.168.31.253
BASEROW_TOKEN=
BASEROW_TABLES={"项目台账":"1"}
BASEROW_DEPARTMENT_FIELD=部门
# 多空间(Baserow 令牌按工作区隔离,每个空间一个令牌)
BASEROW_SOURCES={}
# 自动发现(推荐):配置 Baserow 用户账号,自动列出可见的全部库/表
BASEROW_USER_EMAIL=
BASEROW_USER_PASSWORD=
BASEROW_WORKSPACES=[]
