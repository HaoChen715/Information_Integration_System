# ---- 镜像与端口 ----
TAG=0.3.1
HTTP_PORT=8080

# ---- 应用配置(生产必须改为随机强密钥) ----
SECRET_KEY=please-change-this-to-a-random-strong-key-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- 首次启动自动创建管理员(创建成功后建议清空本段) ----
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ---- 认证后端(按顺序尝试) ----
AUTH_BACKENDS=["local","ldap"]

# ---- AD / LDAP(不用时置 false) ----
LDAP_ENABLED=false
LDAP_SERVER=ldaps://dc.corp.com
LDAP_BIND_DN=CN=svc-iis,OU=Service,DC=corp,DC=com
LDAP_BIND_PASSWORD=change-me
LDAP_BASE_DN=DC=corp,DC=com
LDAP_GROUP_ROLE_MAP={"CN=IIS-Admins,OU=Groups,DC=corp,DC=com":"admin"}
# 仅 389 端口时用 StartTLS;内网 CA 自签时指定 CA 证书(或用 LDAP_TLS_INSECURE=true 跳过校验,仅测试)
LDAP_USE_STARTTLS=false
LDAP_CA_CERT=
LDAP_TLS_INSECURE=false

# ---- OIDC 统一身份认证(不用时置 false) ----
OIDC_ENABLED=false
OIDC_ISSUER=https://platform.liangkui.co/platform/idp
OIDC_CLIENT_ID=iis-web
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES=openid profile email groups
# 后端回调地址,必须与身份平台客户端注册的 redirect URI 完全一致
OIDC_REDIRECT_URI=http://iis.corp:8080/api/auth/oidc/callback
# 登录成功后前端接收 token 的地址
OIDC_POST_LOGIN_REDIRECT=http://iis.corp:8080/oidc-callback
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_ROLE_MAP={"iis-admins":"admin"}
# 内网 CA 自签证书:把 CA 证书挂进容器并填容器内路径(如 /certs/ca.pem),优先于下面的开关
OIDC_CA_CERT=
OIDC_VERIFY_SSL=true
OIDC_COOKIE_SECURE=false
